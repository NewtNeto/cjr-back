// Lojas virtuais e as pessoas que trabalham nelas.

enum StatusLoja {
  PENDENTE // cadastrada, aguardando aprovação de um ADMIN
  ATIVA // aprovada e vendendo
  SUSPENSA // bloqueada temporariamente pela plataforma
  ENCERRADA // fechada definitivamente (o histórico é mantido)

  @@map("status_loja")
}

// Papel da pessoa DENTRO de uma loja específica (diferente do papel global).
enum PapelNaLoja {
  DONO
  VENDEDOR

  @@map("papel_na_loja")
}

model Loja {
  id           Int        @id @default(autoincrement())
  nome         String
  // Texto usado na URL da loja. Ex.: "casa-do-cafe". Único na plataforma.
  slug         String     @unique
  descricao    String?
  logoUrl      String?    @map("logo_url")
  emailContato String     @map("email_contato")
  telefone     String?
  // Somente números (14 dígitos). Opcional, único quando informado.
  cnpj         String?    @unique
  status       StatusLoja @default(PENDENTE)

  // categoria principal da loja (mercado, beleza...)
  categoriaId Int?    @map("categoria_id")
  // imagens do modal: foto de perfil (circulo da loja) e banner (topo da pagina). a logo svg fica em logoUrl
  fotoUrl     String? @map("foto_url")
  bannerUrl   String? @map("banner_url")

  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime  @updatedAt @map("atualizado_em")
  excluidoEm   DateTime? @map("excluido_em")

  membros    MembroLoja[]
  produtos   Produto[]
  pedidos    Pedido[]
  avaliacoes AvaliacaoLoja[]

  categoria Categoria? @relation(fields: [categoriaId], references: [id])

  @@index([categoriaId])
  @@map("lojas")
}

// Liga uma pessoa a uma loja (quem é dono e quem vende nela).
model MembroLoja {
  id        Int         @id @default(autoincrement())
  lojaId    Int         @map("loja_id")
  usuarioId Int         @map("usuario_id")
  papel     PapelNaLoja @default(VENDEDOR)

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  loja    Loja    @relation(fields: [lojaId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  // A mesma pessoa não pode aparecer duas vezes na mesma loja.
  @@unique([lojaId, usuarioId])
  @@index([usuarioId])
  @@map("membros_loja")
}
