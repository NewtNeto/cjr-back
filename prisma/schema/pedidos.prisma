// Carrinho e pedidos.
//
// Regra principal: no checkout, o carrinho é dividido em UM PEDIDO POR LOJA.
// Assim cada loja cuida apenas dos seus próprios pedidos.
//
// Ainda não existem pagamento, entrega nem financeiro: quando esses requisitos
// forem definidos, entram como tabelas novas ligadas a Pedido.

// ---------------------------------------------------------------------------
// Carrinho
// ---------------------------------------------------------------------------

// Cada usuário tem no máximo um carrinho, que pode misturar produtos de várias lojas.
model Carrinho {
  id        String @id @default(uuid()) @db.Uuid
  usuarioId String @unique @map("usuario_id") @db.Uuid

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  usuario Usuario        @relation(fields: [usuarioId], references: [id])
  itens   ItemCarrinho[]

  @@map("carrinhos")
}

// O preço NÃO é guardado aqui: o carrinho sempre mostra o preço atual do produto.
model ItemCarrinho {
  id         String @id @default(uuid()) @db.Uuid
  carrinhoId String @map("carrinho_id") @db.Uuid
  produtoId  String @map("produto_id") @db.Uuid
  quantidade Int    @default(1)

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  carrinho Carrinho @relation(fields: [carrinhoId], references: [id], onDelete: Cascade)
  produto  Produto  @relation(fields: [produtoId], references: [id])

  // Adicionar o mesmo produto de novo deve aumentar a quantidade, não criar outra linha.
  @@unique([carrinhoId, produtoId])
  @@index([produtoId])
  @@map("itens_carrinho")
}

// ---------------------------------------------------------------------------
// Pedidos
// ---------------------------------------------------------------------------

enum StatusPedido {
  PENDENTE // criado, aguardando a loja confirmar
  CONFIRMADO // a loja aceitou o pedido
  ENVIADO
  ENTREGUE
  CANCELADO

  @@map("status_pedido")
}

// Um pedido pertence a um cliente e a UMA loja. Pedidos nunca são apagados:
// quando algo dá errado, o status muda para CANCELADO.
model Pedido {
  id         String       @id @default(uuid()) @db.Uuid
  // Número amigável para mostrar ao cliente e à loja (o id UUID fica interno).
  numero     Int          @unique @default(autoincrement())
  clienteId  String       @map("cliente_id") @db.Uuid
  lojaId     String       @map("loja_id") @db.Uuid
  status     StatusPedido @default(PENDENTE)
  // Soma dos subtotais dos itens, calculada na hora da compra.
  total      Decimal      @db.Decimal(12, 2)
  observacao String?

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  cliente Usuario      @relation(fields: [clienteId], references: [id])
  loja    Loja         @relation(fields: [lojaId], references: [id])
  itens   ItemPedido[]

  @@index([clienteId])
  @@index([lojaId, status])
  @@map("pedidos")
}

// Foto do produto no momento da compra. Título e preço são copiados para que
// mudanças futuras no produto não alterem o histórico do pedido.
model ItemPedido {
  id            String  @id @default(uuid()) @db.Uuid
  pedidoId      String  @map("pedido_id") @db.Uuid
  produtoId     String  @map("produto_id") @db.Uuid
  tituloProduto String  @map("titulo_produto")
  precoUnitario Decimal @map("preco_unitario") @db.Decimal(12, 2)
  quantidade    Int
  // precoUnitario * quantidade, guardado pronto para facilitar relatórios.
  subtotal      Decimal @db.Decimal(12, 2)

  pedido  Pedido  @relation(fields: [pedidoId], references: [id])
  produto Produto @relation(fields: [produtoId], references: [id])

  @@index([pedidoId])
  @@index([produtoId])
  @@map("itens_pedido")
}
