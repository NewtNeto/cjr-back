// implementacao de comentarios
// o comentario fica em uma avaliacao de loja, em uma avaliacao de produto ou direto em um produto,
// sempre em um lugar so (regra CHECK na migration comentarios)
// lista simples em ordem de data, sem resposta a outro comentario

model Comentario {
  id        Int    @id @default(autoincrement())
  // autor do comentario
  usuarioId Int    @map("usuario_id")
  // nao pode ficar vazio
  texto     String

  // onde o comentario foi feito: so um destes e preenchido
  avaliacaoLojaId    Int? @map("avaliacao_loja_id")
  avaliacaoProdutoId Int? @map("avaliacao_produto_id")
  produtoId          Int? @map("produto_id")

  criadoEm     DateTime @default(now()) @map("criado_em")
  // diferente de criadoEm: comentario editado
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  usuario          Usuario           @relation(fields: [usuarioId], references: [id])
  // apagou a avaliacao ou o produto, os comentarios vao junto
  avaliacaoLoja    AvaliacaoLoja?    @relation(fields: [avaliacaoLojaId], references: [id], onDelete: Cascade)
  avaliacaoProduto AvaliacaoProduto? @relation(fields: [avaliacaoProdutoId], references: [id], onDelete: Cascade)
  produto          Produto?          @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  // listando os comentarios de cada lugar em ordem de data
  @@index([avaliacaoLojaId, criadoEm])
  @@index([avaliacaoProdutoId, criadoEm])
  @@index([produtoId, criadoEm])
  @@index([usuarioId])
  @@map("comentarios")
}
