# Copie este arquivo para `.env` e ajuste os valores. O `.env` não vai para o git.

# Conexão com o PostgreSQL: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cjr?schema=public"

# Chave que assina os tokens de login. Use um valor grande e aleatório e nunca compartilhe.
JWT_SECRET="troque-por-uma-chave-grande-e-aleatoria"
# Validade do login em segundos (86400 = 1 dia)
JWT_EXPIRA_EM_SEGUNDOS=86400
# Endereço do front, usado no link do e-mail de recuperação de senha
FRONT_URL="http://localhost:3000"
# NÃO EXCLUA ESSE ARQUIVO